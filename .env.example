# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These values are public identifiers, not secrets; Firestore rules do the protecting.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_APP_ID=

# "local" = no sign-in, progress saved on this device only (handy for trying it out).
# Leave empty to use Firebase. If the Firebase values above are missing, local mode is used automatically.
VITE_DATA_MODE=

# "true" = talk to the local Firebase emulators (npm run emulators).
VITE_USE_EMULATORS=
