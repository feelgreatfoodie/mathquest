rules_version = '2';

// Each parent's Google account owns one family tree: families/{uid}/...
// Kids sign in through the kidSignIn Cloud Function (first name + 4-digit PIN). It returns a
// custom token with role 'kid', familyUid and kidId. A kid reaches only their own kid doc,
// cards and sessions. pinIndex holds PIN hashes and brute-force counters: server only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A registered parent: a verified Google email and a parents/{uid} doc. Only the registerParent
    // function writes that doc, and it stops at MAX_PARENTS (20), so a stranger who finds the URL can
    // sign in but cannot create or read any family.
    function allowedAccount() {
      return request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    // Guards against junk writes: our documents have well under 20 top-level fields.
    function smallDoc() {
      return request.resource == null || request.resource.data.size() < 20;
    }

    // A card's Lightning Round delay (lightningDelayMs), when present, is a whole number of ms from 1000 to 4000. A card written by an
    // older bundle has no such field and passes. A card has at most 15 fields (id, fsrs, attempts, correct, recentMs, lastRating,
    // updatedAt, day, dayGraded, lastResults, missDay, supportLevel, supportRun, supportHold, lightningDelayMs), under smallDoc's 20.
    function lightningDelayOk() {
      return !('lightningDelayMs' in request.resource.data)
        || (request.resource.data.lightningDelayMs is int
          && request.resource.data.lightningDelayMs >= 1000
          && request.resource.data.lightningDelayMs <= 4000);
    }

    // The parent: signed in as this family's Google account, and registered.
    function isParent(uid) {
      return signedInAs(uid) && allowedAccount();
    }

    // A kid: a custom token minted by kidSignIn for exactly this family and this kid.
    function isKid(uid, kidId) {
      return request.auth != null
        && request.auth.token.role == 'kid'
        && request.auth.token.familyUid == uid
        && request.auth.token.kidId == kidId;
    }

    // The only kid doc fields a run writes. Everything else (name, settings, paceMultiplier,
    // hasPin, createdAt) is parent-only.
    function kidOnlyChangedGame() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game']);
    }

    // A kid write may also change `inventory` (owned items, equipped slots, savings goal), next to `game`, and only
    // that: an item buy (inventory.items grows by one, gems drop with a purchases doc, see gemsDropBacked), an equip
    // or unequip, or a goal pin. inventoryOk and equippedOk check the contents. Name, settings and the rest stay
    // parent-only. A write that leaves inventory alone passes through kidOnlyChangedGame as before.
    function kidInventoryOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game', 'inventory']);
    }

    // A kid write may also change `vault` (the pointer map: active count, lastId, closedId), next to `game`, and only that: a
    // vault deposit or a payout chunk (see vaultPointerOk, gemsDropBacked and vaultPayOk). The deposits themselves live in
    // the vault/ subcollection. A write that leaves `vault` alone passes through kidOnlyChangedGame as before, so an old
    // bundle's save stays valid for a kid who has a vault.
    function kidVaultKeysOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game', 'vault']);
    }

    // The hero catalog (HEROES in src/engine/game.ts; a unit test keeps the two equal). A hero id that is not
    // here has no price and cannot be bought.
    function heroPrices() {
      return {'knight': 0, 'wizard': 15, 'ranger': 35, 'robot': 60, 'dragon': 100};
    }

    // The item catalog (ITEMS in src/game/shop/catalog.ts; a unit test keeps the two equal). An item id has its slot
    // as a prefix: w- weapon, g- gear, p- pet, a- adventure, c- camp. An id that is not here has no price and cannot
    // be bought. Prices sit in four bands: common 15-30, rare 50-90, epic 120-180, legendary 250-400.
    function itemPrices() {
      return {
        'w-sword': 20, 'w-wand': 30, 'w-bow': 55, 'w-hammer': 70, 'w-boomerang': 90,
        'g-cape': 15, 'g-helm': 25, 'g-wizhat': 30, 'g-dinohood': 60,
        'p-beetle': 50, 'p-dog': 80, 'p-owl': 120, 'p-pup': 150,
        'a-key': 25, 'a-boots': 50, 'a-lantern': 60, 'a-bridge': 120,
        'c-flag': 15, 'c-banner': 20, 'c-tent': 30, 'c-fire': 55,
        'g-goldarmor': 300, 'w-crystalstaff': 350
      };
    }

    // The owned items, the equipped slots and the savings goal live in the kid doc's top-level `inventory` map, not in
    // `game`. An old bundle (cached on an iPad) writes `game` without them and never touches `inventory`, so its save
    // stays valid for a kid who owns items. A missing inventory reads as {}.
    function itemsOf(d) {
      return d.get('inventory', {}).get('items', []);
    }

    // A kid token adds at most one thing in a write, a hero or an item, never both. An item is added the same way as a
    // hero: the last in inventory.items, in itemPrices, not owned before, and gems drop by exactly its price (no free
    // starter among items). A token that adds a hero adds exactly one (the last in the list, as a purchase appends it), the hero
    // is in the catalog, and gems drop by exactly its price. The free starter hero (price 0) may be added with
    // a gem rise, because a doc with game {} gets its knight and a run's gems in one write; any drop is refused
    // by gemsDropBacked. Without a hero or item change it passes, so runs and equips are unaffected. Only the kid branch
    // uses this.
    function kidHeroGrowthOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      let beforeHeroes = before.get('heroes', []);
      let afterHeroes = after.get('heroes', []);
      let beforeItems = itemsOf(resource.data);
      let afterItems = itemsOf(request.resource.data);
      let heroGrew = afterHeroes.size() == beforeHeroes.size() + 1;
      let itemGrew = afterItems.size() == beforeItems.size() + 1;
      return (afterHeroes.size() == beforeHeroes.size() && afterItems.size() == beforeItems.size())
        || (heroGrew && afterItems.size() == beforeItems.size()
          && afterHeroes[afterHeroes.size() - 1] in heroPrices()
          && !beforeHeroes.hasAny([afterHeroes[afterHeroes.size() - 1]])
          && (heroPrices()[afterHeroes[afterHeroes.size() - 1]] == 0
            || before.get('gems', 0) - after.get('gems', 0) == heroPrices()[afterHeroes[afterHeroes.size() - 1]]))
        || (itemGrew && afterHeroes.size() == beforeHeroes.size()
          && afterItems[afterItems.size() - 1] in itemPrices()
          && !beforeItems.hasAny([afterItems[afterItems.size() - 1]])
          && before.get('gems', 0) - after.get('gems', 0) == itemPrices()[afterItems[afterItems.size() - 1]]);
    }

    // The game economy is client-trusted by design: grading runs on the device, so a kid token can write any
    // run it claims. This caps the damage of one tampered write. Measured on 58 stored sessions (3 kids, 1 family):
    // at most 504 xp per session. A kid write may raise xp by at most 2000 (about 4x the measured maximum, room
    // for longer sessions). Gems: a run earns at most 10 (GEM_RUN_MAX in src/engine/gems.ts, after the Gem speed
    // and the throttle), so a kid write may raise gems by at most 10. There is no check against gems earned today:
    // the throttle slows the rate in the app and never stops a save. A drop is not limited here (gemsDropBacked
    // and kidHeroGrowthOk handle it). Only the kid branch uses this; parents and the Admin SDK are unchanged.
    function kidRaiseOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      return after.get('gems', 0) - before.get('gems', 0) <= 10
        && after.get('xp', 0) - before.get('xp', 0) <= 2000;
    }

    // The path of one purchases doc. Called only after the id passed the format check, so a bad id never reaches it.
    function purchasePath(uid, kidId, id) {
      return /databases/$(database)/documents/families/$(uid)/kids/$(kidId)/purchases/$(id);
    }

    // A decrease of game.gems is legal only in the write that buys one hero or one item. That write sets game.lastPurchaseId
    // to a new id, creates the purchases doc with that id, adds exactly one hero or exactly one item (in inventory.items, not both), and
    // the doc's cost equals the drop and its heroId (or itemId) is the one added. The rules cannot look up "some purchases doc", so the kid doc names
    // it: lastPurchaseId is the key that exists/getAfter can read. A stale full-doc copy, a reused id, a wrong
    // cost, a drop without a hero or two docs for one buy all fail here. Applies to the kid and the parent branch;
    // the Admin SDK skips rules, so a support correction stays possible. A missing game or gems reads as 0.
    function gemsDropBacked(uid, kidId) {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      let drop = before.get('gems', 0) - after.get('gems', 0);
      let id = after.get('lastPurchaseId', '');
      let beforeHeroes = before.get('heroes', []);
      let afterHeroes = after.get('heroes', []);
      let beforeItems = itemsOf(resource.data);
      let afterItems = itemsOf(request.resource.data);
      let heroGrew = afterHeroes.size() == beforeHeroes.size() + 1 && afterItems.size() == beforeItems.size();
      let itemGrew = afterItems.size() == beforeItems.size() + 1 && afterHeroes.size() == beforeHeroes.size();
      return drop <= 0
        || (id is string && id.matches('^[A-Za-z0-9_-]{1,40}$')
          && id != before.get('lastPurchaseId', '')
          && (heroGrew || itemGrew)
          && !exists(purchasePath(uid, kidId, id))
          && existsAfter(purchasePath(uid, kidId, id))
          && getAfter(purchasePath(uid, kidId, id)).data.cost == drop
          && ((heroGrew && getAfter(purchasePath(uid, kidId, id)).data.get('heroId', '') == afterHeroes[afterHeroes.size() - 1])
            || (itemGrew && getAfter(purchasePath(uid, kidId, id)).data.get('itemId', '') == afterItems[afterItems.size() - 1])))
        || vaultDepositBacked(uid, kidId, drop, beforeHeroes, afterHeroes, beforeItems, afterItems);
    }

    // The second legal drop: a vault deposit. The kid doc names the new deposit (vault.lastId, a new id), the deposit doc
    // is created in the same write and its amount equals the drop. No hero or item changes, so a deposit never doubles as
    // a purchase. The pointer's own change (active + 1, at most 3) is held by vaultPointerOk, and the deposit doc's
    // fields (rate, bonus, createdAt = request.time) by vaultCreateOk.
    function vaultDepositBacked(uid, kidId, drop, beforeHeroes, afterHeroes, beforeItems, afterItems) {
      let vid = request.resource.data.get('vault', {}).get('lastId', '');
      return vid is string && vid.matches('^[A-Za-z0-9_-]{1,40}$')
        && vid != resource.data.get('vault', {}).get('lastId', '')
        && afterHeroes.size() == beforeHeroes.size()
        && afterItems.size() == beforeItems.size()
        && !exists(vaultPath(uid, kidId, vid))
        && existsAfter(vaultPath(uid, kidId, vid))
        && getAfter(vaultPath(uid, kidId, vid)).data.amount == drop;
    }

    // The path of one vault deposit. Called only after the id passed the format check.
    function vaultPath(uid, kidId, id) {
      return /databases/$(database)/documents/families/$(uid)/kids/$(kidId)/vault/$(id);
    }

    // The kid doc's `vault` pointer map changes only in two ways. A deposit: active goes up by one (at most 3), lastId is a
    // new id whose deposit doc is created in this write. A close (the first payout chunk): active goes down by one, lastId
    // stays, closedId names a deposit that was active before the write and is not after. The map is never written without
    // one of the two. No time is read here: the close is timed by vaultPayOk.
    function vaultPointerOk(uid, kidId) {
      let b = resource.data.get('vault', {});
      let a = request.resource.data.get('vault', {});
      return a == b
        || (a is map
          && a.keys().hasOnly(['active', 'lastId', 'closedId'])
          && a.get('active', 0) is int
          && a.get('active', 0) >= 0
          && a.get('active', 0) <= 3
          && ((a.get('active', 0) == b.get('active', 0) + 1
              && a.get('lastId', '') is string
              && a.get('lastId', '').matches('^[A-Za-z0-9_-]{1,40}$')
              && a.get('lastId', '') != b.get('lastId', '')
              && a.get('closedId', '') == b.get('closedId', '')
              && !exists(vaultPath(uid, kidId, a.get('lastId', '')))
              && existsAfter(vaultPath(uid, kidId, a.get('lastId', ''))))
            || (a.get('active', 0) == b.get('active', 0) - 1
              && a.get('lastId', '') == b.get('lastId', '')
              && a.get('closedId', '') is string
              && a.get('closedId', '').matches('^[A-Za-z0-9_-]{1,40}$')
              && exists(vaultPath(uid, kidId, a.get('closedId', '')))
              && get(vaultPath(uid, kidId, a.get('closedId', ''))).data.status == 'active'
              && getAfter(vaultPath(uid, kidId, a.get('closedId', ''))).data.status != 'active')));
    }

    // A deposit doc is valid only in the write that takes its gems: the amount (an int, at least 10) equals the drop in
    // game.gems, the kid's vault map gains one active entry named for this deposit (lastId, active + 1, at most 3), the
    // parent has the vault on, the term is 3, 7 or 14, ratePer10 is the parent's rate for that term (the default 1, 3 or 7
    // when none is set, and never above 10), bonus is floor(amount / 10) * ratePer10, status is active, nothing is paid out,
    // and createdAt is request.time (the server's clock; the doc has no client time). maturesAt is not stored: the payout
    // rule reads createdAt plus the term.
    function vaultCreateOk(uid, kidId, depositId) {
      let kidP = /databases/$(database)/documents/families/$(uid)/kids/$(kidId);
      let before = get(kidP).data;
      let after = getAfter(kidP).data;
      let vb = before.get('vault', {});
      let va = after.get('vault', {});
      let rates = before.get('settings', {}).get('vault', {});
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'amount', 'termDays', 'ratePer10', 'bonus', 'status', 'paidOut', 'createdAt'])
        && d.keys().hasAll(['id', 'amount', 'termDays', 'ratePer10', 'bonus', 'status', 'paidOut', 'createdAt'])
        && d.id == depositId
        && d.amount is int && d.amount >= 10
        && d.termDays in [3, 7, 14]
        && rates.get('on', false) == true
        && d.ratePer10 == (d.termDays == 3 ? rates.get('d3', 1) : (d.termDays == 7 ? rates.get('d7', 3) : rates.get('d14', 7)))
        && d.ratePer10 >= 0 && d.ratePer10 <= 10
        && d.bonus == math.floor(d.amount / 10) * d.ratePer10
        && d.status == 'active'
        && d.paidOut == 0
        && d.createdAt == request.time
        && before.get('game', {}).get('gems', 0) - after.get('game', {}).get('gems', 0) == d.amount
        && va.get('lastId', '') == depositId
        && va.get('active', 0) == vb.get('active', 0) + 1
        && va.get('active', 0) <= 3;
    }

    // A payout is a run of chunks, each one write. A chunk raises game.gems by `chunk` (1 to 10, the kid-write raise bound)
    // and the deposit's paidOut by the same chunk, so gems leave the vault only as fast as paidOut records it, and a repeated
    // or stale chunk fails because the stored paidOut and gems have moved on. The deposit stays `collecting` (or `breaking`)
    // until paidOut equals the payout, and only the last chunk sets `collected` (paidOut == amount + bonus) or `broken`
    // (paidOut == amount). The FIRST chunk leaves `active`: collecting (or collected when it is also the last) only when
    // request.time >= createdAt + termDays, server times both; breaking (or broken) any time, and the bonus is lost.
    // collectedAt is request.time, and the kid's vault map drops its active count in the same write (closedId names the
    // deposit). Later chunks change paidOut (and status on the last) and nothing else, the vault map stays, and the mode
    // never switches, so the principal cannot be drawn early and the bonus later. amount, bonus and term never change.
    function vaultPayOk(uid, kidId, depositId) {
      let kidP = /databases/$(database)/documents/families/$(uid)/kids/$(kidId);
      let gb = get(kidP).data.get('game', {});
      let ga = getAfter(kidP).data.get('game', {});
      let vb = get(kidP).data.get('vault', {});
      let va = getAfter(kidP).data.get('vault', {});
      let b = resource.data;
      let a = request.resource.data;
      let changed = a.diff(b).affectedKeys();
      let chunk = a.paidOut - b.paidOut;
      let total = a.amount + a.bonus;
      let matured = request.time >= b.createdAt + duration.value(b.termDays, 'd');
      return a.paidOut is int
        && chunk >= 1 && chunk <= 10
        && ga.get('gems', 0) - gb.get('gems', 0) == chunk
        && ((b.status == 'active'
            && changed.hasOnly(['status', 'paidOut', 'collectedAt'])
            && a.collectedAt == request.time
            && va.get('closedId', '') == depositId
            && va.get('active', 0) == vb.get('active', 0) - 1
            && ((a.status == 'breaking' && a.paidOut < a.amount)
              || (a.status == 'broken' && a.paidOut == a.amount)
              || (matured && a.status == 'collecting' && a.paidOut < total)
              || (matured && a.status == 'collected' && a.paidOut == total)))
          || (va == vb
            && ((b.status == 'collecting'
                && ((a.status == 'collecting' && changed.hasOnly(['paidOut']) && a.paidOut < total)
                  || (a.status == 'collected' && changed.hasOnly(['status', 'paidOut']) && a.paidOut == total)))
              || (b.status == 'breaking'
                && ((a.status == 'breaking' && changed.hasOnly(['paidOut']) && a.paidOut < a.amount)
                  || (a.status == 'broken' && changed.hasOnly(['status', 'paidOut']) && a.paidOut == a.amount))))));
    }

    // The vault setting the parent writes: only on, d3, d7 and d14, on a boolean, each rate a whole number from 0 to 10 per
    // 10 gems saved (the defaults are 1, 3 and 7, so the cap lets a parent at most double the longest). The screen offers the
    // same range; this is the check that holds when a screen does not. Kids never write settings. Applies to the parent branch.
    function vaultSettingsOk() {
      let v = request.resource.data.get('settings', {}).get('vault', {});
      return v is map
        && v.keys().hasOnly(['on', 'd3', 'd7', 'd14'])
        && (!('on' in v) || v.on is bool)
        && (!('d3' in v) || (v.d3 is int && v.d3 >= 0 && v.d3 <= 10))
        && (!('d7' in v) || (v.d7 is int && v.d7 >= 0 && v.d7 <= 10))
        && (!('d14' in v) || (v.d14 is int && v.d14 >= 0 && v.d14 <= 10));
    }

    // The Lightning Round delay floor the parent sets, settings.lightningFloorMs, when present, is a whole number of ms from 1000 to 4000
    // (the Parent screen offers the same range). A write without it passes. Applies to the parent branches; kids never write settings.
    function lightningFloorOk() {
      let f = request.resource.data.get('settings', {}).get('lightningFloorMs', 1000);
      return f is int && f >= 1000 && f <= 4000;
    }

    // game.hero may change only to a hero the kid owns after the write (a buy equips the new hero in the same
    // write). An unchanged hero passes, so a stored doc that already disagrees can still be saved.
    function heroChangeOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      return after.get('hero', 'knight') == before.get('hero', 'knight')
        || after.get('heroes', ['knight']).hasAny([after.get('hero', 'knight')]);
    }

    // inventory.equipped may change only to items the kid owns after the write (inventory.items), each in its own slot
    // (w- weapon, g- gear, p- pet) and in the catalog. An unchanged equipped passes, so a stored doc that already
    // disagrees can still be saved. Any other slot name is refused. An empty or missing map passes (unequip).
    function equippedOk() {
      let before = resource.data.get('inventory', {});
      let after = request.resource.data.get('inventory', {});
      let eq = after.get('equipped', {});
      let owned = after.get('items', []);
      let prices = itemPrices();
      return eq == before.get('equipped', {})
        || (eq is map
          && eq.keys().hasOnly(['weapon', 'gear', 'pet'])
          && (!('weapon' in eq) || (eq.weapon is string && eq.weapon.matches('^w-.*') && eq.weapon in prices && eq.weapon in owned))
          && (!('gear' in eq) || (eq.gear is string && eq.gear.matches('^g-.*') && eq.gear in prices && eq.gear in owned))
          && (!('pet' in eq) || (eq.pet is string && eq.pet.matches('^p-.*') && eq.pet in prices && eq.pet in owned)));
    }

    // The inventory map is valid when it is unchanged, or when it holds only items, equipped and goal, the items
    // list is a list that keeps every earlier entry and grows by at most one (a buy), and a goal is a short string.
    // A removed inventory reads as {} and loses its items, so it fails. The kid branch also needs one more rule
    // (kidInventoryOk). Applies to the kid and the parent branch.
    function inventoryOk() {
      let before = resource.data.get('inventory', {});
      let after = request.resource.data.get('inventory', {});
      let beforeItems = before.get('items', []);
      let afterItems = after.get('items', []);
      return after == before
        || (after is map
          && after.keys().hasOnly(['items', 'equipped', 'goal'])
          && afterItems is list
          && afterItems.size() <= beforeItems.size() + 1
          && afterItems.size() <= 60
          && afterItems.hasAll(beforeItems)
          && (!('goal' in after) || (after.goal is string && after.goal.size() <= 40)));
    }

    // xp and bestCombo only grow, and the hero list never loses an entry (the item list is held by inventoryOk). gemsDropBacked misses a stale copy that
    // keeps gems but rewinds xp (a real loss: xp 1363 to 467). A missing field reads as 0 or empty, so a
    // game {} doc can still be filled. Admin SDK writes skip rules, so a support reset stays possible.
    function gameMonotonicOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      return after.get('xp', 0) >= before.get('xp', 0)
        && after.get('bestCombo', 0) >= before.get('bestCombo', 0)
        && after.get('heroes', []).hasAll(before.get('heroes', []));
    }

    // A purchases-log entry is valid only in the transaction that buys the hero or the item: the entry names exactly
    // one of heroId and itemId, the kid doc after the write holds one more of that kind (the logged one, not owned
    // before, nothing else added) and exactly `cost` fewer gems, and `cost` is the catalog price. get() reads the doc
    // before the write, getAfter() reads it after, so a lone entry, a wrong cost or a wrong hero is refused.
    function purchaseEntryOk(uid, kidId, purchaseId) {
      let kidPath = /databases/$(database)/documents/families/$(uid)/kids/$(kidId);
      let before = get(kidPath).data.get('game', {});
      let after = getAfter(kidPath).data.get('game', {});
      let beforeItems = itemsOf(get(kidPath).data);
      let afterItems = itemsOf(getAfter(kidPath).data);
      let e = request.resource.data;
      let isHero = e.keys().hasAny(['heroId']);
      let isItem = e.keys().hasAny(['itemId']);
      return e.keys().hasOnly(['id', 'heroId', 'itemId', 'cost', 'at'])
        && e.keys().hasAll(['id', 'cost', 'at'])
        && isHero != isItem
        && e.id == purchaseId
        && after.get('lastPurchaseId', '') == purchaseId
        && e.cost is int && e.cost > 0
        && e.at is number
        && before.get('gems', 0) - after.get('gems', 0) == e.cost
        && ((isHero
            && e.heroId is string
            && e.heroId in heroPrices()
            && e.cost == heroPrices()[e.heroId]
            && after.get('heroes', []).hasAll([e.heroId])
            && !before.get('heroes', []).hasAny([e.heroId])
            && after.get('heroes', []).size() == before.get('heroes', []).size() + 1
            && afterItems.size() == beforeItems.size())
          || (isItem
            && e.itemId is string
            && e.itemId in itemPrices()
            && e.cost == itemPrices()[e.itemId]
            && afterItems.hasAll([e.itemId])
            && !beforeItems.hasAny([e.itemId])
            && afterItems.size() == beforeItems.size() + 1
            && after.get('heroes', []).size() == before.get('heroes', []).size()));
    }

    // The Overworld save (world/main). The 9 fields below, each the right type, plus an optional lastMode (10 fields); openedChests holds at most 500
    // card ids, bossesDefeated at most the 3 regions, keys 0 to 99. The checks read sizes and types only, never loop over
    // the lists, so a full save costs a fixed handful of expressions.
    function worldOk() {
      let w = request.resource.data;
      return w.keys().hasOnly(['region', 'x', 'y', 'facing', 'openedChests', 'bossesDefeated', 'keys', 'version', 'updatedAt', 'lastMode'])
        && w.keys().hasAll(['region', 'x', 'y', 'facing', 'openedChests', 'bossesDefeated', 'keys', 'version', 'updatedAt'])
        && w.region in ['meadow', 'forest', 'castle']
        && w.x is int && w.x >= 0 && w.x < 100
        && w.y is int && w.y >= 0 && w.y < 100
        && w.facing in ['up', 'down', 'left', 'right']
        && w.openedChests is list && w.openedChests.size() <= 500
        && w.bossesDefeated is list && w.bossesDefeated.size() <= 3
        && w.keys is int && w.keys >= 0 && w.keys <= 99
        && w.version == 1
        && w.updatedAt is number
        && (!('lastMode' in w) || w.lastMode in ['dungeon', 'prereader', 'overworld']);
    }

    // The camp: one doc per land, world/camp_meadow, world/camp_forest and world/camp_castle (the tents and flags a kid placed in that land).
    // 3 fields: placed, version, updatedAt. placed is a list of at most 4 entries (at most 1 tent and 3 flags), each exactly
    // { region, kind, x, y }: region is the land of the doc, x a whole number 0..39, y a whole number 0..29 (the map size). Rules cannot loop,
    // and a single doc of 12 entries passes the 1000-expression limit (7 fit), so the 4 slots of one land are checked one by one.
    // Every index is read only inside a branch that has already checked the list size (n > i && ...). A slot that is missing a field, or holds
    // something that is not a map, makes the rule error, and an error denies the write.
    function campLandOf(campId) {
      return {'camp_meadow': 'meadow', 'camp_forest': 'forest', 'camp_castle': 'castle'}.get(campId, '');
    }
    function campEntry(e, land) {
      return e.size() == 4 && e.region == land && e.kind in ['tent', 'flag']
        && e.x is int && e.x >= 0 && e.x < 40 && e.y is int && e.y >= 0 && e.y < 30;
    }
    function campSlot(p, n, land, i) {
      return n <= i || campEntry(p[i], land);
    }
    function campTent(p, n, i) {
      return n > i && p[i].kind == 'tent' ? 1 : 0;
    }
    function campOk(campId) {
      let c = request.resource.data;
      let land = campLandOf(campId);
      let p = c.get('placed', null);
      let n = p.size();
      let tents = campTent(p, n, 0) + campTent(p, n, 1) + campTent(p, n, 2) + campTent(p, n, 3);
      return land != ''
        && c.keys().hasOnly(['placed', 'version', 'updatedAt'])
        && c.keys().hasAll(['placed', 'version', 'updatedAt'])
        && c.version == 1
        && c.updatedAt is number
        && p is list && n <= 4
        && campSlot(p, n, land, 0) && campSlot(p, n, land, 1) && campSlot(p, n, land, 2) && campSlot(p, n, land, 3)
        && tents <= 1
        && (n < 4 || tents == 1);
    }

    // The parent registry, its counter and the kid-name claims. Only the Admin SDK in Cloud Functions
    // touches them.
    match /parents/{document=**} {
      allow read, write: if false;
    }
    match /meta/{document=**} {
      allow read, write: if false;
    }
    match /nameKeys/{document=**} {
      allow read, write: if false;
    }

    // The username index: usernames/{usernameLower} = { familyUid, kidId, createdAt }. A username is not secret (it is printed
    // on the sign-in card), but the index maps it to a family and a kid, so no client reads or writes it. kidSignIn does one
    // `get` with the Admin SDK.
    match /usernames/{document=**} {
      allow read, write: if false;
    }

    // The release gate: config/app holds { minVersion }, the oldest build allowed to write. Any signed-in
    // account, kid or parent, reads it (one public number). No client writes it: the release script sets it
    // through the Admin SDK, which skips these rules. Every other config doc stays closed.
    match /config/{docId} {
      allow read: if docId == 'app' && request.auth != null;
      allow write: if false;
    }

    // PIN hashes, salts and attempt counters. Only the Admin SDK in Cloud Functions touches them.
    match /pinIndex/{document=**} {
      allow read, write: if false;
    }

    // The family doc holds the parent PIN hash, and no kid screen reads a family field, so
    // kids get no access here.
    match /families/{uid} {
      allow read: if isParent(uid);
      allow write: if isParent(uid) && smallDoc();

      // Devices that signed a player in: families/{uid}/devices/{deviceId} = { firstSeen, lastSeen, kids[], label }. The Admin SDK
      // (kidSignIn) creates and updates them. The family's grown-ups read them and may change `label` and nothing else, as a
      // string of 1 to 40 characters. A client cannot create or delete a device, and a kid token reads nothing here.
      match /devices/{deviceId} {
        allow read: if isParent(uid);
        allow update: if isParent(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label'])
          && request.resource.data.label is string
          && request.resource.data.label.size() >= 1
          && request.resource.data.label.size() <= 40;
        allow create, delete: if false;
      }

      match /kids/{kidId} {
        allow read: if isParent(uid) || isKid(uid, kidId);
        allow delete: if isParent(uid);
        allow create: if isParent(uid) && smallDoc() && request.resource.data.id == kidId && vaultSettingsOk() && lightningFloorOk();
        allow update: if (isParent(uid) && smallDoc() && request.resource.data.id == kidId && gemsDropBacked(uid, kidId) && gameMonotonicOk() && heroChangeOk() && inventoryOk() && equippedOk() && vaultPointerOk(uid, kidId) && vaultSettingsOk() && lightningFloorOk())
          || (isKid(uid, kidId) && smallDoc() && request.resource.data.id == kidId && (kidOnlyChangedGame() || kidInventoryOk() || kidVaultKeysOk()) && gemsDropBacked(uid, kidId) && gameMonotonicOk() && heroChangeOk() && inventoryOk() && equippedOk() && vaultPointerOk(uid, kidId) && kidHeroGrowthOk() && kidRaiseOk());

        match /cards/{cardId} {
          allow read: if isParent(uid) || isKid(uid, kidId);
          allow delete: if isParent(uid);
          allow create, update: if (isParent(uid) || isKid(uid, kidId)) && smallDoc()
            && request.resource.data.id == cardId && lightningDelayOk();
        }

        // Purchases log: the parent reads it, nobody edits or deletes it. A kid token (or the parent device
        // playing as a kid) creates an entry only for this kidId and only with its game change.
        match /purchases/{purchaseId} {
          allow read: if isParent(uid);
          allow create: if (isParent(uid) || isKid(uid, kidId)) && purchaseEntryOk(uid, kidId, purchaseId);
          allow update, delete: if false;
        }

        // The Overworld save: one doc, world/main. Owner-only: the kid token for this kidId and the parent read and
        // write it; a sibling's token, another family and anonymous clients match no rule. The doc holds at most these
        // 10 fields, so it stays far under 20, and openedChests holds at most 500 card ids. It is written alone: it
        // never touches the kid doc, so the kid doc rules (and their expression count) do not change. A kid cannot delete it.
        match /world/{docId} {
          allow read: if isParent(uid) || isKid(uid, kidId);
          allow create, update: if (isParent(uid) || isKid(uid, kidId)) && docId == 'main' && smallDoc() && worldOk();
          allow delete: if isParent(uid);
        }

        // The camp: world/camp_meadow, world/camp_forest and world/camp_castle, the tent and flags a kid placed in each land. Same owners as
        // world/main: the kid token for this kidId and the parent read and write them, a sibling's token, another family and anonymous
        // clients match no rule. They never touch world/main or the kid doc. Read and delete come from the world/{docId} rule above.
        match /world/{campId} {
          allow create, update: if (isParent(uid) || isKid(uid, kidId)) && smallDoc() && campOk(campId);
        }

        // The gem vault: one doc per deposit. Parent and kid read. A deposit is created only with the gems it takes, a payout
        // chunk updates it only with the gems it gives (vaultCreateOk, vaultPayOk). The parent device playing as the kid is
        // held to the same checks. Nobody deletes a deposit: the parent's history stays whole.
        match /vault/{depositId} {
          allow read: if isParent(uid) || isKid(uid, kidId);
          allow create: if (isParent(uid) || isKid(uid, kidId)) && depositId.matches('^[A-Za-z0-9_-]{1,40}$') && vaultCreateOk(uid, kidId, depositId);
          allow update: if (isParent(uid) || isKid(uid, kidId)) && vaultPayOk(uid, kidId, depositId);
          allow delete: if false;
        }

        match /sessions/{sessionId} {
          allow read: if isParent(uid) || isKid(uid, kidId);
          allow delete: if isParent(uid);
          allow create, update: if (isParent(uid) || isKid(uid, kidId)) && smallDoc();
        }
      }
    }
  }
}
