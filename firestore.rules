rules_version = '2';

// Each parent's Google account owns one family tree: families/{uid}/...
// Kids sign in through the kidSignIn Cloud Function (first name + 4-digit PIN). It returns a
// custom token with role 'kid', familyUid and kidId. A kid reaches only their own kid doc,
// cards and sessions. pinIndex holds PIN hashes and brute-force counters: server only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A registered parent: a verified Google email and a parents/{uid} doc. Only the registerParent
    // function writes that doc, and it stops at MAX_PARENTS (20), so a stranger who finds the URL can
    // sign in but cannot create or read any family.
    function allowedAccount() {
      return request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    // Guards against junk writes: our documents have well under 20 top-level fields.
    function smallDoc() {
      return request.resource == null || request.resource.data.size() < 20;
    }

    // The parent: signed in as this family's Google account, and registered.
    function isParent(uid) {
      return signedInAs(uid) && allowedAccount();
    }

    // A kid: a custom token minted by kidSignIn for exactly this family and this kid.
    function isKid(uid, kidId) {
      return request.auth != null
        && request.auth.token.role == 'kid'
        && request.auth.token.familyUid == uid
        && request.auth.token.kidId == kidId;
    }

    // The only kid doc fields a run writes. Everything else (name, settings, paceMultiplier,
    // hasPin, createdAt) is parent-only.
    function kidOnlyChangedGame() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game']);
    }

    // The hero catalog (HEROES in src/engine/game.ts; a unit test keeps the two equal). A hero id that is not
    // here has no price and cannot be bought.
    function heroPrices() {
      return {'knight': 0, 'wizard': 15, 'ranger': 35, 'robot': 60, 'dragon': 100};
    }

    // A kid token that adds a hero adds exactly one (the last in the list, as a purchase appends it), the hero
    // is in the catalog, and gems drop by exactly its price. The free starter hero (price 0) may be added with
    // a gem rise, because a doc with game {} gets its knight and a run's gems in one write; any drop is refused
    // by gemsDropBacked. Without a hero change it passes, so runs and equips are unaffected. Only the kid branch
    // of the kid-doc update uses this.
    function kidHeroGrowthOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      let beforeHeroes = before.get('heroes', []);
      let afterHeroes = after.get('heroes', []);
      return afterHeroes.size() == beforeHeroes.size()
        || (afterHeroes.size() == beforeHeroes.size() + 1
          && afterHeroes[afterHeroes.size() - 1] in heroPrices()
          && !beforeHeroes.hasAny([afterHeroes[afterHeroes.size() - 1]])
          && (heroPrices()[afterHeroes[afterHeroes.size() - 1]] == 0
            || before.get('gems', 0) - after.get('gems', 0) == heroPrices()[afterHeroes[afterHeroes.size() - 1]]));
    }

    // The game economy is client-trusted by design: grading runs on the device, so a kid token can write any
    // run it claims. This caps the damage of one tampered write. Measured on 58 stored sessions (3 kids, 1 family):
    // at most 504 xp and 9 gems per session. A kid write may raise gems by at most 50 and xp by at most 2000
    // (about 5x and 4x the measured maxima, room for longer sessions). A drop is not limited here (gemsDropBacked
    // and kidHeroGrowthOk handle it). Only the kid branch uses this; parents and the Admin SDK are unchanged.
    function kidRaiseOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      return after.get('gems', 0) - before.get('gems', 0) <= 50
        && after.get('xp', 0) - before.get('xp', 0) <= 2000;
    }

    // The path of one purchases doc. Called only after the id passed the format check, so a bad id never reaches it.
    function purchasePath(uid, kidId, id) {
      return /databases/$(database)/documents/families/$(uid)/kids/$(kidId)/purchases/$(id);
    }

    // A decrease of game.gems is legal only in the write that buys one hero. That write sets game.lastPurchaseId
    // to a new id, creates the purchases doc with that id, adds exactly one hero, and the doc's cost equals the
    // drop and its heroId is the hero added. The rules cannot look up "some purchases doc", so the kid doc names
    // it: lastPurchaseId is the key that exists/getAfter can read. A stale full-doc copy, a reused id, a wrong
    // cost, a drop without a hero or two docs for one buy all fail here. Applies to the kid and the parent branch;
    // the Admin SDK skips rules, so a support correction stays possible. A missing game or gems reads as 0.
    function gemsDropBacked(uid, kidId) {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      let drop = before.get('gems', 0) - after.get('gems', 0);
      let id = after.get('lastPurchaseId', '');
      let beforeHeroes = before.get('heroes', []);
      let afterHeroes = after.get('heroes', []);
      return drop <= 0
        || (id is string && id.matches('^[A-Za-z0-9_-]{1,40}$')
          && id != before.get('lastPurchaseId', '')
          && afterHeroes.size() == beforeHeroes.size() + 1
          && !exists(purchasePath(uid, kidId, id))
          && existsAfter(purchasePath(uid, kidId, id))
          && getAfter(purchasePath(uid, kidId, id)).data.cost == drop
          && getAfter(purchasePath(uid, kidId, id)).data.heroId == afterHeroes[afterHeroes.size() - 1]);
    }

    // game.hero may change only to a hero the kid owns after the write (a buy equips the new hero in the same
    // write). An unchanged hero passes, so a stored doc that already disagrees can still be saved.
    function heroChangeOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      return after.get('hero', 'knight') == before.get('hero', 'knight')
        || after.get('heroes', ['knight']).hasAny([after.get('hero', 'knight')]);
    }

    // xp and bestCombo only grow, and the hero list never loses an entry. gemsDropBacked misses a stale copy that
    // keeps gems but rewinds xp (a real loss: xp 1363 to 467). A missing field reads as 0 or empty, so a
    // game {} doc can still be filled. Admin SDK writes skip rules, so a support reset stays possible.
    function gameMonotonicOk() {
      let before = resource.data.get('game', {});
      let after = request.resource.data.get('game', {});
      return after.get('xp', 0) >= before.get('xp', 0)
        && after.get('bestCombo', 0) >= before.get('bestCombo', 0)
        && after.get('heroes', []).hasAll(before.get('heroes', []));
    }

    // A purchases-log entry is valid only in the transaction that buys the hero: the kid doc after the write
    // holds one more hero (the logged one, not owned before) and exactly `cost` fewer gems. get() reads the doc
    // before the write, getAfter() reads it after, so a lone entry, a wrong cost or a wrong hero is refused.
    function purchaseEntryOk(uid, kidId, purchaseId) {
      let kidPath = /databases/$(database)/documents/families/$(uid)/kids/$(kidId);
      let before = get(kidPath).data.get('game', {});
      let after = getAfter(kidPath).data.get('game', {});
      let e = request.resource.data;
      return e.keys().hasOnly(['id', 'heroId', 'cost', 'at'])
        && e.keys().hasAll(['id', 'heroId', 'cost', 'at'])
        && e.id == purchaseId
        && after.get('lastPurchaseId', '') == purchaseId
        && e.heroId is string
        && e.heroId in heroPrices()
        && e.cost is int && e.cost > 0 && e.cost == heroPrices()[e.heroId]
        && e.at is number
        && after.get('heroes', []).hasAll([e.heroId])
        && !before.get('heroes', []).hasAny([e.heroId])
        && after.get('heroes', []).size() == before.get('heroes', []).size() + 1
        && before.get('gems', 0) - after.get('gems', 0) == e.cost;
    }

    // The parent registry, its counter and the kid-name claims. Only the Admin SDK in Cloud Functions
    // touches them.
    match /parents/{document=**} {
      allow read, write: if false;
    }
    match /meta/{document=**} {
      allow read, write: if false;
    }
    match /nameKeys/{document=**} {
      allow read, write: if false;
    }

    // The release gate: config/app holds { minVersion }, the oldest build allowed to write. Any signed-in
    // account, kid or parent, reads it (one public number). No client writes it: the release script sets it
    // through the Admin SDK, which skips these rules. Every other config doc stays closed.
    match /config/{docId} {
      allow read: if docId == 'app' && request.auth != null;
      allow write: if false;
    }

    // PIN hashes, salts and attempt counters. Only the Admin SDK in Cloud Functions touches them.
    match /pinIndex/{document=**} {
      allow read, write: if false;
    }

    // The family doc holds the parent PIN hash, and no kid screen reads a family field, so
    // kids get no access here.
    match /families/{uid} {
      allow read: if isParent(uid);
      allow write: if isParent(uid) && smallDoc();

      match /kids/{kidId} {
        allow read: if isParent(uid) || isKid(uid, kidId);
        allow delete: if isParent(uid);
        allow create: if isParent(uid) && smallDoc() && request.resource.data.id == kidId;
        allow update: if (isParent(uid) && smallDoc() && request.resource.data.id == kidId && gemsDropBacked(uid, kidId) && gameMonotonicOk() && heroChangeOk())
          || (isKid(uid, kidId) && smallDoc() && request.resource.data.id == kidId && kidOnlyChangedGame() && gemsDropBacked(uid, kidId) && gameMonotonicOk() && heroChangeOk() && kidHeroGrowthOk() && kidRaiseOk());

        match /cards/{cardId} {
          allow read: if isParent(uid) || isKid(uid, kidId);
          allow delete: if isParent(uid);
          allow create, update: if (isParent(uid) || isKid(uid, kidId)) && smallDoc()
            && request.resource.data.id == cardId;
        }

        // Purchases log: the parent reads it, nobody edits or deletes it. A kid token (or the parent device
        // playing as a kid) creates an entry only for this kidId and only with its game change.
        match /purchases/{purchaseId} {
          allow read: if isParent(uid);
          allow create: if (isParent(uid) || isKid(uid, kidId)) && purchaseEntryOk(uid, kidId, purchaseId);
          allow update, delete: if false;
        }

        match /sessions/{sessionId} {
          allow read: if isParent(uid) || isKid(uid, kidId);
          allow delete: if isParent(uid);
          allow create, update: if (isParent(uid) || isKid(uid, kidId)) && smallDoc();
        }
      }
    }
  }
}
